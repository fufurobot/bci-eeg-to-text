# Example environment file for bci-eeg-to-text.
#
# Copy to `.env` and fill in real values:
#     cp .env.example .env && chmod 600 .env
#
# `.env` is git-ignored (.gitignore) and MUST NEVER be committed or exposed.
# This template contains NO credentials -- keep it that way.

# GitHub fine-grained personal access token, used by the maintenance scripts in
# `scripts/` to file issues / open pull requests and to read CI status.
# Required scopes: Issues (RW), Pull requests (RW), Contents (RW), Actions (R).
# Create one at: https://github.com/settings/personal-access-tokens
GH_TOKEN=

# Optional: override the repository the maintenance scripts act on.
# GH_REPO=owner/name

# --- Dataset location -------------------------------------------------------
# Where the corpora live. Nothing about the layout is hard-coded.
EEG_TEXT_BCI_DATA_ROOT=./eeg-text-bci-data

# Subdirectory of the root that holds the corpora (e.g. ds005170, ds004952).
EEG_TEXT_BCI_DATA_SUBDIR=bci-eeg

# Whether the dataset root may be written to. Default false, because the
# corpora are normally a read-only mount: with false, `split --link` writes its
# symlink tree to the CURRENT DIRECTORY instead. Set true only if the root is
# genuinely writable and you would rather keep splits beside the data.
# The links are always relative, so either location survives the tree moving.
EEG_TEXT_BCI_DATA_WRITABLE=false
