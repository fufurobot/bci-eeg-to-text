# Example environment file for bci-eeg-to-text.
#
# Copy to `.env` and fill in real values:
#     cp .env.example .env && chmod 600 .env
#
# `.env` is git-ignored (.gitignore) and MUST NEVER be committed or exposed.
# This template contains NO credentials -- keep it that way.

# GitHub fine-grained personal access token, used by the maintenance scripts in
# `scripts/` to file issues / open pull requests and to read CI status.
# Required scopes: Issues (RW), Pull requests (RW), Contents (RW), Actions (R).
# Create one at: https://github.com/settings/personal-access-tokens
GH_TOKEN=

# Optional: override the repository the maintenance scripts act on.
# GH_REPO=owner/name

# Optional: dataset root. Defaults to `./eeg-text-bci-data` (read-only mount).
# EEG_TEXT_BCI_DATA_ROOT=./eeg-text-bci-data
